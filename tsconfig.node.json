{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "files": ["src/core/ui/results/format.ts"],
  "include": [
    "*.config.ts",
    "build",
    "scripts/**/*.ts",
    "tests/e2e",
    "tests/perf",
    "src/core",
    "src/game",
    "src/app/screens/Research/ladderMath.ts",
    "src/app/screens/Research/content.ts",
    "src/app/screens/Research/data.ts",
    "src/app/screens/Research/dataTypes.ts",
    "src/app/screens/Research/survivors.ts",
    "src/app/sources.ts"
  ],
  "exclude": [
    "src/core/**/*.test.ts",
    "src/core/**/*.test.tsx",
    "src/core/**/__fixtures__",
    "src/core/**/*.fixture.ts",
    "src/core/ui",
    "src/core/testing",
    "src/game/*/ui",
    "src/game/**/*.test.ts",
    "src/game/**/__fixtures__",
    "src/game/*/testing"
  ]
}
