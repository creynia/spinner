{
  "name": "spinner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/gen-icons.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --base /spinner/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:perf": "npm run build && PERF=1 playwright test --project=perf",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gallery:check": "node scripts/check-gallery.mjs",
    "research:sim": "node scripts/research/sim.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run gallery:check && npm test"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
