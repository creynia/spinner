  {
    "schema": 1,
    "id": "red-with-zero-boost",
    "name": "Red with a zero boost",
    "game": "roulette",
    "unit": 2500,
    "vars": {
      "boosts": 0,
      "zeroOff": 0
    },
    "stages": [
      {
        "id": "base",
        "layout": [
          {
            "bet": "red",
            "amount": {
              "units": 1
            }
          }
        ],
        "rules": [
          {
            "id": "enough",
            "when": {
              "cmp": [
                {
                  "var": "boosts"
                },
                ">=",
                5
              ]
            },
            "then": [
              {
                "stop": "five-boosts"
              }
            ]
          },
          {
            "id": "boost-on",
            "when": {
              "countInLast": {
                "event": "zero",
                "n": 20,
                "atLeast": 2,
                "partial": true
              }
            },
            "cooldown": 20,
            "then": [
              {
                "goto": "boost"
              }
            ]
          }
        ]
      },
      {
        "id": "boost",
        "extends": "base",
        "onEnter": [
          {
            "inc": "boosts"
          }
        ],
        "onExit": [
          {
            "set": "zeroOff",
            "to": 0
          }
        ],
        "layout": [
          {
            "bet": "red",
            "amount": {
              "units": 2
            }
          },
          {
            "bet": "straight:0",
            "amount": 500,
            "when": {
              "cmp": [
                {
                  "var": "zeroOff"
                },
                "==",
                0
              ]
            }
          }
        ],
        "rules": [
          {
            "id": "zero-off",
            "once": "stage",
            "when": {
              "cmp": ["net", ">", 0]
            },
            "then": [
              {
                "set": "zeroOff",
                "to": 1
              }
            ]
          },
          {
            "id": "boost-off",
            "when": {
              "cmp": ["roundsInStage", ">=", 10]
            },
            "then": [
              {
                "goto": "base"
              }
            ]
          }
        ]
      }
    ]
  },
