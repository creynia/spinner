  {
    "schema": 1,
    "id": "trailing-stop-red",
    "name": "Red with a trailing stop",
    "game": "roulette",
    "unit": 2500,
    "vars": {
      "armed": 0,
      "lock": 0
    },
    "stages": [
      {
        "id": "play",
        "layout": [
          {
            "bet": "red",
            "amount": {
              "units": 1
            }
          }
        ],
        "rules": [
          {
            "id": "arm",
            "once": true,
            "when": {
              "cmp": ["net", ">=", 20000]
            },
            "then": [
              {
                "set": "armed",
                "to": 1
              },
              {
                "set": "lock",
                "to": {
                  "sub": ["net", 10000]
                }
              }
            ]
          },
          {
            "id": "raise",
            "when": {
              "all": [
                {
                  "cmp": [
                    {
                      "var": "armed"
                    },
                    "==",
                    1
                  ]
                },
                {
                  "cmp": [
                    {
                      "sub": ["net", 10000]
                    },
                    ">",
                    {
                      "var": "lock"
                    }
                  ]
                }
              ]
            },
            "then": [
              {
                "set": "lock",
                "to": {
                  "sub": ["net", 10000]
                }
              }
            ]
          },
          {
            "id": "hit",
            "when": {
              "all": [
                {
                  "cmp": [
                    {
                      "var": "armed"
                    },
                    "==",
                    1
                  ]
                },
                {
                  "cmp": [
                    "net",
                    "<=",
                    {
                      "var": "lock"
                    }
                  ]
                }
              ]
            },
            "then": [
              {
                "stop": "trailing-stop"
              }
            ]
          }
        ]
      }
    ]
  },
