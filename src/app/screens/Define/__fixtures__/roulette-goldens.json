              "units": 1
            }
          }
        ],
        "rules": [
          {
            "when": {
              "cmp": ["roundsInStage", ">=", 50]
            },
            "then": [
              {
                "stop": "plan-complete"
              }
            ]
          }
        ]
      }
    ]
  },
