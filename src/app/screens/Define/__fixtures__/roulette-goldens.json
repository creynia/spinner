    "schema": 1,
    "id": "percent-bankroll-red",
    "name": "2% of bankroll on red",
    "game": "roulette",
    "unit": 2500,
    "vars": {
      "stake": 2500
    },
    "stages": [
      {
        "id": "play",
        "layout": [
